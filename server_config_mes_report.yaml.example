# 合併到 production server_config.yaml；請勿覆蓋既有設定。
mes_report:
  # 每台設備只設定該設備所在廠別：MOD1 或 MOD2
  facility: MOD2
  oracle:
    user: MISSELECT
    password_env: CAPI_MES_ORACLE_PASSWORD
    tns:
      MOD1:
        host: 10.172.3.55
        port: 1521
        service_name: pncmr
      MOD2:
        host: 10.174.1.79
        port: 1521
        service_name: pnemr

# 啟動 capi_server 前，另以 service 環境變數提供密碼：
# CAPI_MES_ORACLE_PASSWORD=<password>
