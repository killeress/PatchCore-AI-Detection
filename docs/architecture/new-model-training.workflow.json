    {"from": "review_tiles", "to": "train_bundle", "variant": "emphasis", "fromSide": "bottom", "toSide": "top", "via": [[430, 181], [500, 181]]},
    {"from": "train_bundle", "to": "completed", "variant": "emphasis", "fromSide": "top", "toSide": "bottom", "via": [[500, 181], [625, 181]]}
  ]
